+// SSL_get_write_aead_ctx returns the borrowed write AEAD context. This is for
+// TLS connections with an installed write cipher. The pointer is valid until
+// the write cipher is replaced or the connection is freed.
+OPENSSL_EXPORT EVP_AEAD_CTX *SSL_get_write_aead_ctx(SSL *ssl);
+
+// SSL_get_write_iv_sequence returns the borrowed fixed write nonce and sets
+// `*sequence` to the live, writable TLS record counter. Callers generating
+// records externally must keep this counter synchronized. `*noad` is always
+// zero: current BoringSSL record ciphers require additional authenticated data.
+// The nonce pointer has the same lifetime as `SSL_get_write_aead_ctx`.
+OPENSSL_EXPORT const uint8_t *SSL_get_write_iv_sequence(SSL *ssl,
+                                                     uint64_t **sequence,
+                                                     char *noad);

